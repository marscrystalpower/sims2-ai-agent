    },
    {
      "nid": 38,
      "simGuid": "32639681",
      "firstName": "Andrew",
      "lastName": "Martin",
      "description": "Andrew loves living with his surrogate aunts and his son.  He has a passion for video games and is happy to have a son that also loves games.  Will he be able to cope with his mother's death and finally get out on his own?"
    },
    {
      "nid": 200,
