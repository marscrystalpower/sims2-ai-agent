{
  "neighborhood": "G001",
  "resolved": [
    {
      "nid": 19,
      "simGuid": "B263764F",
      "firstName": "Jason",
      "lastName": "Greenman",
      "description": "Jason moved to Riverblossom Hills after hearing his brother spin wonderful tales of the beautiful countryside - and a beauty he did find!  Will he and his new family prosper?"
    },
    {
      "nid": 18,
      "simGuid": "126366E0",
      "firstName": "Leod",
      "lastName": "McGreggor",
      "description": "Leod comes from a long line of farmers.  He left his homeland to start his own farm but will he be able to run it without the help of friends and family?"
    },
    {
      "nid": 20,
      "simGuid": "F2637922",
      "firstName": "Rose",
      "lastName": "Greenman",
      "description": "Rose quickly became the center of attention after rooting herself in Riverblossom Hills.  Will she thrive in the limelight, or back away to bask alone in the sun?"
    },
    {
      "nid": 21,
      "simGuid": "52637B68",
      "firstName": "Patricia",
      "lastName": "Wan",
      "description": "Patricia moved to town with Cleo to find a great story, not love. Will the love she found with Gabe last, or will his daughter cause them problems?"
    },
    {
      "nid": 202,
      "simGuid": "92AD57B9",
      "firstName": "Daisy",
      "lastName": "Greenman",
      "description": "Will Daisy bloom into the lovely flower that her parents expect or will she be a thorn to Jason and Rose?"
    },
    {
      "nid": 23,
      "simGuid": "12637E80",
      "firstName": "Cleo",
      "lastName": "Shikibu",
      "description": "Cleo is happy to move closer to her favorite aunt, but will living away from the city be the best thing for her?  Will that adorable farmer ever notice that she's noticing him?"
    },
    {
      "nid": 24,
      "simGuid": "F2638114",
      "firstName": "Gabe",
      "lastName": "O'Mackey",
      "description": "Gabe is a loveable nerd who is in love with Patricia Wan.  He's a teacher at the local high school and is oblivious to the conflict between his daughter and Patricia."
    },
    {
      "nid": 29,
      "simGuid": "92638A9E",
      "firstName": "Morty",
      "lastName": "Roth",
      "description": "Charming, yet sophisticated, Morty brings a bit of high society to the small town of Riverblossom Hills.  He hopes that the fresh air and nearby relations will do his family some good."
    },
    {
      "nid": 30,
      "simGuid": "12638CC7",
      "firstName": "Stella",
      "lastName": "Roth",
      "description": "Making new friends comes pretty easy to Stella, but only when there are interesting people around.  This town seems so much smaller to her than where she grew up."
    },
    {
      "nid": 27,
      "simGuid": "526384F7",
      "firstName": "Jules",
      "lastName": "O'Mackey",
      "description": "Jules loves her dad but wishes he didn't have to teach at HER former high school.  She dreams of being a Journalist someday and is thinking of writing a story following the life of Daisy Greenman."
    },
    {
      "nid": 44,
      "simGuid": "D2788B87",
      "firstName": "Seth",
      "lastName": "O'Mackey",
      "description": null
    },
    {
      "nid": 32,
      "simGuid": "52638EA8",
      "firstName": "Sandra",
      "lastName": "Roth",
      "description": "Sandra is loud and boisterous and has no problems letting people know what's on her mind - and right now that's Jacob Martin!"
    },
    {
      "nid": 45,
      "simGuid": "D2788C74",
      "firstName": "Prudence",
      "lastName": "O'Mackey",
      "description": null
    },
    {
